{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "server.py",
      "vercel.json",
      "Build/index.html",
      "Build/TemplateData/**",
      "ML_BUILD/Build/index.html",
      "ML_BUILD/Build/TemplateData/**",
      "Build/unity_web_build.*",
      "ML_BUILD/Build/ML_BUILD.*",
      "**/*.br"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "source": "**/Build/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          }
        ]
      }
    ]
  }
}